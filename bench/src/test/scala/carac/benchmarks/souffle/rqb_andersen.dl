// Input relations
.decl addressOf(y: symbol, x: symbol)
.input addressOf(IO=file, header=false)
.decl assign(y: symbol, z: symbol)
.input assign(IO=file, header=false)
.decl loadT(y: symbol, x: symbol)
.input loadT(IO=file, header=false)
.decl store(y: symbol, x: symbol)
.input store(IO=file, header=false)

// Output relation
.decl pointsTo(y: symbol, x: symbol)
.output pointsTo

// Rules
pointsTo(y, x) :- addressOf(y, x).

pointsTo(y, x) :- assign(y, z), pointsTo(z, x).

pointsTo(y, w) :-
    loadT(y, x),
    pointsTo(x, z),
    pointsTo(z, w).

pointsTo(z, w) :-
    store(y, x),
    pointsTo(y, z),
    pointsTo(x, w).
